

<!-- =========================
     FLIGHT (same template, only items replaced)
========================= -->
<basis core="group" name="flight-items" if="'[##cms.query.module-type##]'='flight'">
    <div class="block mx-auto ul-list w-full">
        <ul class="w-full ">
            <li class="bg-bgColor-100 rounded-type-1 text-zin-950 text-base text-center p-1 mb-1"><span>مسیر های پر تردد</span></li>

            <li class="cursor-pointer hover:text-primary text-textColor p-1 pr-1.5 text-sm" onclick="SelectPlace(this)" data-id="1192689">
                <span>ایروان - (تمام فرودگاه‌ها)</span>
            </li>
            <li class="cursor-pointer hover:text-primary text-textColor p-1 pr-1.5 text-sm" onclick="SelectPlace(this)" data-id="1203548">
                <span>تهران - (تمام فرودگاه‌ها)</span>
            </li>
            <li class="cursor-pointer hover:text-primary text-textColor p-1 pr-1.5 text-sm" onclick="SelectPlace(this)" data-id="1190766">
                <span>اورومچی - (تمام فرودگاه‌ها)</span>
            </li>
            <li class="cursor-pointer hover:text-primary text-textColor p-1 pr-1.5 text-sm" onclick="SelectPlace(this)" data-id="1189731">
                <span>تفلیس - (تمام فرودگاه‌ها)</span>
            </li>
            <li class="cursor-pointer hover:text-primary text-textColor p-1 pr-1.5 text-sm" onclick="SelectPlace(this)" data-id="1173505">
                <span>دبی - (تمام فرودگاه‌ها)</span>
            </li>
            <li class="cursor-pointer hover:text-primary text-textColor p-1 pr-1.5 text-sm" onclick="SelectPlace(this)" data-id="1182348">
                <span>مسکو - (تمام فرودگاه‌ها)</span>
            </li>
        </ul>
    </div>
</basis>
